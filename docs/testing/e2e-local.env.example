# Local Playwright runs use the seeded Prisma users by default.
# Set WMS_E2E_USE_SEEDED_CREDENTIALS=0 to require explicit credentials.
WMS_E2E_USE_SEEDED_CREDENTIALS=1

# Optional overrides (never commit real production/AWS credentials):
# WMS_E2E_SYSTEM_ADMIN_EMAIL=admin@scmayher.com
# WMS_E2E_SYSTEM_ADMIN_PASSWORD=Admin123*
# WMS_E2E_MANAGER_EMAIL=manager@scmayher.com
# WMS_E2E_MANAGER_PASSWORD=Manager123*
# WMS_E2E_WAREHOUSE_OPERATOR_EMAIL=operator@scmayher.com
# WMS_E2E_WAREHOUSE_OPERATOR_PASSWORD=Operator123*
# WMS_E2E_SALES_EXECUTIVE_EMAIL=sales@scmayher.com
# WMS_E2E_SALES_EXECUTIVE_PASSWORD=Sales123*
